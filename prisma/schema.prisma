// Modelo de datos del ERP de condominios.
// Toda tabla de negocio lleva administradoraId para aislar los datos de cada cliente.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  SUPERADMIN // dueño de la plataforma
  ADMINISTRADOR // administra las propiedades asignadas (o todas, si es principal)
  COMITE // solo lectura de su condominio
  RESIDENTE // ve sus avisos de cobro, pagos y saldo
}

enum TipoUnidad {
  DEPARTAMENTO
  CASA
  OFICINA
  LOCAL
  ESTACIONAMIENTO
  BODEGA
}

enum RelacionUnidad {
  PROPIETARIO
  RESIDENTE
}

enum EstadoPeriodo {
  ABIERTO
  CERRADO
}

enum TipoGasto {
  COMUN // se reparte por alícuota
  INDIVIDUAL // se carga a una unidad
}

enum EstadoEnvio {
  ENVIADO // entregado al servidor de correo
  SIMULADO // sin servidor de correo configurado: se guardó una copia local
  ERROR
}

enum EstadoVotacion {
  BORRADOR // aún no la ven los residentes
  ABIERTA
  CERRADA
}

enum PonderacionVoto {
  ALICUOTA // cada unidad pesa según su alícuota (lo habitual en copropiedad)
  UNIDAD // una unidad, un voto
}

// Para qué sirve un enlace de un solo uso.
enum TipoToken {
  RECUPERACION // olvidó su contraseña (vence en 1 hora)
  INVITACION // la administración lo invitó a crear su cuenta (vence en 7 días)
}

// COM-001: en qué etapa está la comunidad. Las operaciones de dinero (emitir cobros,
// registrar pagos) solo se permiten en HABILITADA_FINANCIERA.
enum EstadoComunidad {
  EN_CONFIGURACION // se están cargando sus datos; nada visible para residentes
  HABILITADA_ADMINISTRATIVA // muro, votaciones e invitaciones; sin cobros
  HABILITADA_FINANCIERA // además emite cobros y registra pagos
}

// Supuesto provisional (D-COM-04): lista simple hasta verificar si la ley define tipos.
enum TipoComunidad {
  EDIFICIO
  CONDOMINIO_CASAS
  MIXTO
  OFICINAS
  OTRO
}

enum ModalidadIncorporacion {
  NUEVA // comunidad que parte de cero en Convive
  EXISTENTE // ya funcionaba con otra administración o sistema (migración mixta)
}

// COM-001 · Entrega 2: estructura física. Agrupaciones libres (no todos tienen torres o pisos).
enum TipoAgrupacion {
  SECTOR
  TORRE
  EDIFICIO
  PISO
  NIVEL // subterráneo o nivel de estacionamientos
  OTRO
}

enum ClaseEspacio {
  ESTACIONAMIENTO
  BODEGA
}

// Condición jurídica: de quién es (distinto de para qué se usa y de quién lo usa).
enum RegimenEspacio {
  UNIDAD_PRIVADA // tiene rol y alícuota propios (es una unidad que se cobra)
  ACCESORIO // pertenece a una unidad principal
  BIEN_COMUN // de la comunidad; no se cobra ni tiene alícuota
  POR_DEFINIR // aún no se sabe: no se presume ninguno
}

// Destino: para qué está.
enum DestinoEspacio {
  PRIVADO
  VISITAS
  USO_COMUN
  SERVICIO
}

enum EstadoEspacio {
  DISPONIBLE
  ASIGNADO
  FUERA_DE_USO
}

// Derecho o autorización de uso, con vigencia. No es propiedad.
enum TipoAsignacion {
  PERMANENTE // uso exclusivo autorizado (por acta, reglamento o escritura)
  TEMPORAL // por un período
}

enum TipoInstalacion {
  ASCENSOR
  BOMBA
  PORTON
  CAMARA
  ELECTRICO
  SANITARIO
  CONTRA_INCENDIOS
  ESPACIO_COMUN // quincho, sala multiuso, piscina, plaza
  EQUIPAMIENTO
  OTRO
}

enum EstadoInstalacion {
  OPERATIVA
  CON_OBSERVACIONES
  FUERA_DE_SERVICIO
  SIN_INFORMACION
}

enum MedioPago {
  TRANSFERENCIA
  EFECTIVO
  CHEQUE
  OTRO
}

model Administradora {
  id        String   @id @default(cuid())
  nombre    String
  pais      String   @default("CL")
  moneda    String   @default("CLP")
  creadoEn  DateTime @default(now())

  usuarios     Usuario[]
  condominios  Condominio[]
  personas     Persona[]
  unidades     Unidad[]
  periodos     Periodo[]
  gastos       Gasto[]
  avisos       AvisoCobro[]
  pagos        Pago[]
  proveedores  Proveedor[]
  publicaciones Publicacion[]
  votaciones   Votacion[]
  registros    RegistroCambio[]
}

model Usuario {
  id               String   @id @default(cuid())
  administradoraId String?
  administradora   Administradora? @relation(fields: [administradoraId], references: [id], onDelete: Cascade)
  nombre           String
  correo           String   @unique
  claveHash        String
  rol              Rol
  // Para COMITE: condominio que puede ver. Para RESIDENTE: persona vinculada.
  condominioId     String?
  // Para ADMINISTRADOR: el principal ve todas las propiedades de la administradora (también las
  // nuevas) y maneja las cuentas; los demás ven solo las asignadas en AsignacionCondominio.
  accesoTodas      Boolean  @default(false)
  condominio       Condominio? @relation(fields: [condominioId], references: [id], onDelete: SetNull)
  personaId        String?  @unique
  persona          Persona? @relation(fields: [personaId], references: [id], onDelete: SetNull)
  creadoEn         DateTime @default(now())
  // Al cambiar la contraseña se cierran las sesiones abiertas antes de esa fecha.
  claveActualizadaEn DateTime?
  // Una cuenta desactivada no puede ingresar y sus sesiones abiertas dejan de servir.
  activo           Boolean  @default(true)
  ultimoIngresoEn  DateTime?

  tokensRecuperacion TokenRecuperacion[]
  asignaciones       AsignacionCondominio[]

  @@index([administradoraId])
}

// Propiedades que puede administrar un administrador que no es principal.
model AsignacionCondominio {
  usuarioId    String
  usuario      Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  condominioId String
  condominio   Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  creadoEn     DateTime   @default(now())

  @@id([usuarioId, condominioId])
  @@index([condominioId])
}

model Condominio {
  id                 String   @id @default(cuid())
  administradoraId   String
  administradora     Administradora @relation(fields: [administradoraId], references: [id], onDelete: Cascade)
  nombre             String
  rut                String?
  direccion          String
  comuna             String?
  // Porcentaje del gasto común que va al fondo de reserva (ej. 5 = 5 %)
  porcentajeReserva  Decimal  @default(5) @db.Decimal(5, 2)
  // Tasa de interés mensual por mora (ej. 1.5 = 1,5 % mensual)
  tasaInteresMora    Decimal  @default(0) @db.Decimal(5, 2)
  diaVencimiento     Int      @default(10)
  // Cuántas unidades con alícuota tiene la propiedad en total (para seguir el avance de la carga)
  totalUnidades      Int?
  // COM-001 · configurador. Las comunidades que ya existían quedan HABILITADA_FINANCIERA
  // (ver la migración); las nuevas nacen EN_CONFIGURACION.
  estado             EstadoComunidad @default(EN_CONFIGURACION)
  estadoCambiadoEn   DateTime?
  tipo               TipoComunidad?
  modalidad          ModalidadIncorporacion?
  region             String?
  fechaIncorporacion DateTime? @db.Date
  // Antecedentes legales: inscripción del reglamento de copropiedad, notaría, fecha, etc.
  reglamento         String?
  // Información complementaria disponible (texto libre).
  observaciones      String?
  creadoEn           DateTime @default(now())

  unidades      Unidad[]
  periodos      Periodo[]
  usuarios      Usuario[]
  asignaciones  AsignacionCondominio[]
  publicaciones Publicacion[]
  votaciones    Votacion[]
  agrupaciones  Agrupacion[]
  espacios      Espacio[]
  instalaciones Instalacion[]

  @@index([administradoraId])
}

// COM-001 · Estructura física: sector, torre, edificio, piso... Puede anidarse (torre > piso).
model Agrupacion {
  id               String   @id @default(cuid())
  administradoraId String
  condominioId     String
  condominio       Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  tipo             TipoAgrupacion
  nombre           String
  padreId          String?
  padre            Agrupacion?  @relation("Subagrupaciones", fields: [padreId], references: [id], onDelete: Restrict)
  hijas            Agrupacion[] @relation("Subagrupaciones")
  orden            Int      @default(0)
  creadoEn         DateTime @default(now())

  unidades      Unidad[]
  espacios      Espacio[]
  instalaciones Instalacion[]

  @@unique([condominioId, padreId, nombre])
  @@index([administradoraId])
}

// Estacionamiento o bodega, con su condición jurídica, destino y accesibilidad por separado.
// Si es UNIDAD_PRIVADA, se cobra a través de la unidad (Unidad) que lo representa.
model Espacio {
  id                 String   @id @default(cuid())
  administradoraId   String
  condominioId       String
  condominio         Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  clase              ClaseEspacio
  codigo             String
  agrupacionId       String?
  agrupacion         Agrupacion? @relation(fields: [agrupacionId], references: [id], onDelete: SetNull)
  ubicacion          String?
  regimen            RegimenEspacio @default(POR_DEFINIR)
  destino            DestinoEspacio?
  accesible          Boolean  @default(false)
  estado             EstadoEspacio @default(DISPONIBLE)
  // UNIDAD_PRIVADA: la unidad (con alícuota) que es este mismo espacio.
  unidadPropiaId     String?
  unidadPropia       Unidad?  @relation("EspacioUnidadPropia", fields: [unidadPropiaId], references: [id], onDelete: SetNull)
  // ACCESORIO: la unidad principal a la que pertenece.
  unidadPrincipalId  String?
  unidadPrincipal    Unidad?  @relation("EspacioUnidadPrincipal", fields: [unidadPrincipalId], references: [id], onDelete: SetNull)
  respaldo           String?  // documento que acredita la condición (escritura, reglamento, plano)
  observaciones      String?
  creadoEn           DateTime @default(now())
  actualizadoEn      DateTime @updatedAt

  asignaciones AsignacionEspacio[]

  @@unique([condominioId, clase, codigo])
  @@index([administradoraId])
}

// Autorización de uso de un espacio. No se borra: al terminar se le pone fecha "hasta".
model AsignacionEspacio {
  id            String   @id @default(cuid())
  espacioId     String
  espacio       Espacio  @relation(fields: [espacioId], references: [id], onDelete: Cascade)
  tipo          TipoAsignacion
  unidadId      String?
  unidad        Unidad?  @relation(fields: [unidadId], references: [id], onDelete: SetNull)
  personaId     String?
  persona       Persona? @relation(fields: [personaId], references: [id], onDelete: SetNull)
  // Nombre de a quién se asignó, para que el historial se lea aunque después cambie la unidad o la persona.
  beneficiario  String
  desde         DateTime @db.Date
  hasta         DateTime? @db.Date
  respaldo      String?
  observaciones String?
  creadoPor     String
  creadoEn      DateTime @default(now())
  terminadaPor  String?
  terminadaEn   DateTime?

  @@index([espacioId, desde])
}

// Inventario básico de instalaciones, equipos y espacios comunes. Base para mantenciones futuras.
model Instalacion {
  id               String   @id @default(cuid())
  administradoraId String
  condominioId     String
  condominio       Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  tipo             TipoInstalacion
  codigo           String
  nombre           String
  agrupacionId     String?
  agrupacion       Agrupacion? @relation(fields: [agrupacionId], references: [id], onDelete: SetNull)
  ubicacion        String?
  descripcion      String?
  estado           EstadoInstalacion @default(SIN_INFORMACION)
  proveedorId      String?
  proveedor        Proveedor? @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  observaciones    String?
  creadoEn         DateTime @default(now())
  actualizadoEn    DateTime @updatedAt

  @@unique([condominioId, codigo])
  @@index([administradoraId])
}

model Persona {
  id               String   @id @default(cuid())
  administradoraId String
  administradora   Administradora @relation(fields: [administradoraId], references: [id], onDelete: Cascade)
  nombre           String
  documento        String?  // RUT, DNI u otro
  correo           String?
  telefono         String?
  creadoEn         DateTime @default(now())

  unidades UnidadPersona[]
  usuario  Usuario?
  asignacionesEspacio AsignacionEspacio[]

  @@index([administradoraId])
}

model Unidad {
  id               String   @id @default(cuid())
  administradoraId String
  administradora   Administradora @relation(fields: [administradoraId], references: [id], onDelete: Cascade)
  condominioId     String
  condominio       Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  numero           String
  tipo             TipoUnidad @default(DEPARTAMENTO)
  // Porcentaje de participación en el gasto común (ej. 1.25 = 1,25 %)
  alicuota         Decimal  @db.Decimal(9, 6)
  // COM-001: dónde está (torre, piso, sector...). Opcional.
  agrupacionId     String?
  agrupacion       Agrupacion? @relation(fields: [agrupacionId], references: [id], onDelete: SetNull)
  creadoEn         DateTime @default(now())

  espaciosPropios    Espacio[] @relation("EspacioUnidadPropia")
  espaciosVinculados Espacio[] @relation("EspacioUnidadPrincipal")
  asignaciones       AsignacionEspacio[]
  personas UnidadPersona[]
  gastos   Gasto[]
  avisos   AvisoCobro[]
  pagos    Pago[]
  votos    Voto[]

  @@unique([condominioId, numero])
  @@index([administradoraId])
}

model UnidadPersona {
  unidadId  String
  unidad    Unidad  @relation(fields: [unidadId], references: [id], onDelete: Cascade)
  personaId String
  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)
  relacion  RelacionUnidad

  @@id([unidadId, personaId, relacion])
}

model Periodo {
  id               String   @id @default(cuid())
  administradoraId String
  administradora   Administradora @relation(fields: [administradoraId], references: [id], onDelete: Cascade)
  condominioId     String
  condominio       Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  anio             Int
  mes              Int
  estado           EstadoPeriodo @default(ABIERTO)
  vencimiento      DateTime?
  cerradoEn        DateTime?

  gastos Gasto[]
  avisos AvisoCobro[]

  @@unique([condominioId, anio, mes])
  @@index([administradoraId])
}

model Gasto {
  id               String   @id @default(cuid())
  administradoraId String
  administradora   Administradora @relation(fields: [administradoraId], references: [id], onDelete: Cascade)
  periodoId        String
  periodo          Periodo  @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  tipo             TipoGasto
  // Solo para gastos INDIVIDUALES
  unidadId         String?
  unidad           Unidad?  @relation(fields: [unidadId], references: [id], onDelete: Cascade)
  categoria        String
  descripcion      String
  proveedor        String?
  documento        String?  // número de boleta o factura
  monto            Decimal  @db.Decimal(14, 2)
  fecha            DateTime
  creadoEn         DateTime @default(now())

  @@index([administradoraId])
  @@index([periodoId])
}

model AvisoCobro {
  id               String   @id @default(cuid())
  administradoraId String
  administradora   Administradora @relation(fields: [administradoraId], references: [id], onDelete: Cascade)
  periodoId        String
  periodo          Periodo  @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  unidadId         String
  unidad           Unidad   @relation(fields: [unidadId], references: [id], onDelete: Cascade)
  gastoComun       Decimal  @db.Decimal(14, 2)
  fondoReserva     Decimal  @db.Decimal(14, 2)
  cargos           Decimal  @db.Decimal(14, 2)
  // Interés por mora sobre la deuda vencida al momento de emitir
  interes          Decimal  @default(0) @db.Decimal(14, 2)
  total            Decimal  @db.Decimal(14, 2)
  saldo            Decimal  @db.Decimal(14, 2)
  vencimiento      DateTime
  emitidoEn        DateTime @default(now())

  aplicaciones AplicacionPago[]
  envios       EnvioAviso[]

  @@unique([periodoId, unidadId])
  @@index([administradoraId])
}

model Pago {
  id               String   @id @default(cuid())
  administradoraId String
  administradora   Administradora @relation(fields: [administradoraId], references: [id], onDelete: Cascade)
  unidadId         String
  unidad           Unidad   @relation(fields: [unidadId], references: [id], onDelete: Cascade)
  monto            Decimal  @db.Decimal(14, 2)
  fecha            DateTime
  medio            MedioPago
  referencia       String?
  creadoEn         DateTime @default(now())
  // Un pago anulado no se borra: deja de contar para la deuda y el saldo a favor,
  // pero queda a la vista con quién lo anuló, cuándo y por qué.
  anuladoEn        DateTime?
  anuladoPor       String?
  motivoAnulacion  String?

  aplicaciones AplicacionPago[]

  @@index([administradoraId])
}

model AplicacionPago {
  id       String     @id @default(cuid())
  pagoId   String
  pago     Pago       @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  avisoId  String
  aviso    AvisoCobro @relation(fields: [avisoId], references: [id], onDelete: Cascade)
  monto    Decimal    @db.Decimal(14, 2)
}

// Registro de cada correo enviado con un aviso de cobro.
model EnvioAviso {
  id           String      @id @default(cuid())
  avisoId      String
  aviso        AvisoCobro  @relation(fields: [avisoId], references: [id], onDelete: Cascade)
  destinatario String
  estado       EstadoEnvio
  error        String?
  creadoEn     DateTime    @default(now())

  @@index([avisoId])
}

// Catálogo de proveedores de la administradora (mantención, aseo, servicios, etc.).
model Proveedor {
  id               String   @id @default(cuid())
  administradoraId String
  administradora   Administradora @relation(fields: [administradoraId], references: [id], onDelete: Cascade)
  nombre           String
  rut              String?
  rubro            String?
  contacto         String?
  telefono         String?
  correo           String?
  creadoEn         DateTime @default(now())

  instalaciones Instalacion[]

  @@unique([administradoraId, nombre])
}

// Publicaciones del muro de la propiedad: avisos, convocatorias, noticias.
model Publicacion {
  id               String   @id @default(cuid())
  administradoraId String
  administradora   Administradora @relation(fields: [administradoraId], references: [id], onDelete: Cascade)
  condominioId     String
  condominio       Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  titulo           String
  contenido        String
  autor            String
  creadoEn         DateTime @default(now())
  actualizadoEn    DateTime @updatedAt

  @@index([condominioId, creadoEn])
}

// Votaciones en línea de la propiedad. Vota una vez cada unidad; votan sus propietarios
// desde su cuenta, o la administración registra el voto (por ejemplo, en una asamblea).
model Votacion {
  id               String   @id @default(cuid())
  administradoraId String
  administradora   Administradora @relation(fields: [administradoraId], references: [id], onDelete: Cascade)
  condominioId     String
  condominio       Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  titulo           String
  descripcion      String?
  estado           EstadoVotacion @default(BORRADOR)
  ponderacion      PonderacionVoto @default(ALICUOTA)
  cierraEn         DateTime
  publicadaEn      DateTime?
  cerradaEn        DateTime?
  creadoEn         DateTime @default(now())

  opciones OpcionVotacion[]
  votos    Voto[]

  @@index([condominioId, estado])
}

model OpcionVotacion {
  id         String   @id @default(cuid())
  votacionId String
  votacion   Votacion @relation(fields: [votacionId], references: [id], onDelete: Cascade)
  texto      String
  orden      Int

  votos Voto[]
}

model Voto {
  id          String         @id @default(cuid())
  votacionId  String
  votacion    Votacion       @relation(fields: [votacionId], references: [id], onDelete: Cascade)
  opcionId    String
  opcion      OpcionVotacion @relation(fields: [opcionId], references: [id], onDelete: Cascade)
  unidadId    String
  unidad      Unidad         @relation(fields: [unidadId], references: [id], onDelete: Cascade)
  // Quién emitió el voto: la persona (propietario) o la administración.
  emitidoPor  String
  presencial  Boolean        @default(false)
  creadoEn    DateTime       @default(now())

  @@unique([votacionId, unidadId])
}

// Intentos de ingreso, para bloquear temporalmente tras varios fallos.
model IntentoIngreso {
  id       String   @id @default(cuid())
  correo   String
  ip       String?
  exitoso  Boolean
  creadoEn DateTime @default(now())

  @@index([correo, creadoEn])
  @@index([ip, creadoEn])
}

// Enlaces de un solo uso para crear una contraseña (recuperación o invitación).
// Se guarda solo el hash del token.
model TokenRecuperacion {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      TipoToken @default(RECUPERACION)
  tokenHash String   @unique
  expiraEn  DateTime
  usadoEn   DateTime?
  creadoEn  DateTime @default(now())

  @@index([usuarioId])
}

// Registro de cambios: quién hizo qué y cuándo. Guarda nombres y textos (no relaciones)
// para que el historial se conserve aunque después se borre lo registrado.
model RegistroCambio {
  id               String   @id @default(cuid())
  administradoraId String?
  administradora   Administradora? @relation(fields: [administradoraId], references: [id], onDelete: Cascade)
  condominioId     String?
  usuarioId        String?
  usuarioNombre    String
  accion           String
  detalle          String
  creadoEn         DateTime @default(now())

  @@index([administradoraId, creadoEn])
  @@index([condominioId, creadoEn])
}
