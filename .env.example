DATABASE_URL="postgresql://erp:erp@localhost:5432/erp_condominios?schema=public"
SESSION_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-de-32-caracteres"

# Cuenta de plataforma que se crea al publicar por primera vez (npm run db:init).
PLATAFORMA_CORREO=""
PLATAFORMA_CLAVE=""

# Envío de correos (avisos de cobro, invitaciones, recuperar contraseña). Basta UNA opción:
#   BREVO_API_KEY  -> clave de API de Brevo (brevo.com, 300 correos al día gratis)
#   RESEND_API_KEY -> clave de API de Resend (resend.com, 100 al día gratis, exige dominio propio)
#   SMTP_*         -> cualquier servidor SMTP
# Sin ninguna, nada se envía: se guarda una copia en la carpeta correos-simulados/.
BREVO_API_KEY=""
RESEND_API_KEY=""
# Remitente verificado en el servicio. Puede ser solo el correo o "Nombre <correo>".
CORREO_REMITENTE="Convive <avisos@tudominio.cl>"
# Opcional: a dónde llegan las respuestas de los residentes.
CORREO_RESPONDER_A=""

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
